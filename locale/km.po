msgctxt "field:purchase.product_supplier.price,end_date:"
msgid "End Date"
msgstr "កាលបរិច្ឆេទបញ្ចប់"

msgctxt "field:purchase.product_supplier.price,start_date:"
msgid "Start Date"
msgstr "កាលបរិច្ឆេទចាប់ផ្តើម"

msgctxt "field:purchase.product_supplier.price,valid:"
msgid "Valid"
msgstr "ត្រឹមត្រូវ"

msgctxt "help:purchase.product_supplier.price,end_date:"
msgid "Ending date for this price entry to be valid."
msgstr "កាលបរិច្ឆេទបញ្ចប់សុពលភាពនៃតម្លៃនេះ។"

msgctxt "help:purchase.product_supplier.price,start_date:"
msgid "Starting date for this price entry to be valid."
msgstr "កាលបរិច្ឆេទចាប់ផ្ដើមសុពលភាពនៃតម្លៃនេះ។"

#, python-format
msgctxt "model:ir.message,text:msg_prices_overlap"
msgid "The prices \"%(first)s\" and \"%(second)s\" for supplier \"%(supplier)s\" overlap."
msgstr ""
"តម្លៃ «%(first)s» និង «%(second)s» សម្រាប់អ្នកផ្គត់ផ្គង់ «%(supplier)s» "
"មានគ្រាសុពលភាពត្រួតគ្នា។"
